# ================= 必改 =================
ADMIN_USERNAME=admin
# 留空 = 默认口令 admin123（登录后可在「设置」里改，重启不会被覆盖）
# 填写 = 以环境变量为准，每次启动都强制重置为该值。公网部署请填强口令
ADMIN_PASSWORD=

# 32 字节随机串，用于加密凭证；生成：openssl rand -base64 32
# 留空会自动生成到 data/master.key（换机迁移必须一并带走，否则凭证解不开）
MASTER_KEY=

# ================= 网络 =================
# 本机调试保持 127.0.0.1；容器内由 compose 强制为 0.0.0.0
HOST=127.0.0.1
PORT=8000
TZ=Asia/Shanghai
# 出站代理，如 http://127.0.0.1:7890；国内机器留空
# 注意：程序默认忽略系统 HTTP_PROXY/HTTPS_PROXY，需要代理只能在这里显式配置
CHECKIN_PROXY=

# WorkBuddy 的 billing 基址（积分余额/资源包账单接口所在域名，与 chat 域不同）
# WB_BILLING_URL=https://www.codebuddy.cn

# ================= 调度 =================
# Qoder 令牌提前多少小时刷新（云端单点运行，不与客户端竞争）
QODER_REFRESH_MARGIN_H=12

# WorkBuddy 积分余额（资源包账单）刷新
# WB_CREDITS_TTL=60          一次真实查询的有效秒数；页面反复刷新不会反复打上游
# WB_CREDITS_REFRESH_MIN=10  后台定时刷新间隔（分钟），没人开页面时余额也照样往前走

# WorkBuddy 令牌续期（refreshToken 换新 accessToken）
# WB_RENEW_BEFORE_DAYS=3     剩余寿命少于几天就自动续期
# WB_RENEW_CHECK_MIN=60      巡检间隔（分钟）

# Qoder（国际版）出口代理 —— 可选。实测补全「桌面端同款身份头」后，机房直连也能
# 拿到每日活动（2026-10-30 真实账号领取成功）；只有出口被墙/被拦时才需要配这里。
# 配置后仅国际版请求走该代理（WorkBuddy / Qoder CN 直连不变）。
# QODER_INTL_PROXY=http://user:pass@proxy:port

# Qoder deviceToken 保活阈值（天）：剩余不足就自动换新
# QODER_KEEPALIVE_DAYS=7

# Qoder 桌面端身份形（一般不用改）
# QODER_DESKTOP_VERSION=0.4.3        cosy-version 头
# QODER_MACHINE_HOSTNAME=DESKTOP-QODER   cosy-machinehostname 头的固定形

# ================= 调试 / 联调（一般不用改）=================
# 数据目录（默认 <repo>/data；tests/*.py 用临时目录隔离）
# CHECKIN_DATA_DIR=
# 基址覆盖：把面板指到本地假上游 tools/mock_api.py 时用（默认值见 README §12）
# WB_BASE_URL=http://127.0.0.1:8899
# WB_BILLING_URL=http://127.0.0.1:8899
# QODER_BASE_URL=http://127.0.0.1:8899
# 客户端装在非标准路径时指定（只在导入器里生效）
# WORKBUDDY_CLIENT_EXE=D:\path\to\WorkBuddy.exe
# deploy/remote_deploy.py 用；口令只从环境变量读，别写进文件
# SSH_HOST=1.2.3.4
# SSH_USER=ubuntu
# SSH_PORT=22
# SSH_PASSWORD=
# REMOTE_DIR=/home/ubuntu/checkin-hub

# ================= 反向代理（docker compose）=================
# 留空   → 用 http://<服务器IP> 直接访问（不加密，仅建议内网/测试）
# 有域名 → 填域名，Caddy 自动申请 Let's Encrypt 证书
# 无域名又想 HTTPS → 填 <服务器IP>.sslip.io（如 119.29.1.2.sslip.io），可免费拿证书
DOMAIN=

# ================= 构建加速（可选）=================
# 国内服务器默认走腾讯云 PyPI 镜像，海外可改成 https://pypi.org/simple
# PIP_INDEX=https://mirrors.cloud.tencent.com/pypi/simple
# PIP_TRUSTED_HOST=mirrors.cloud.tencent.com
